NODE_ENV=development
PORT=4100
CLIENT_ORIGIN=http://localhost:5173
# Leave blank for the in-memory demo store. Set to a MongoDB Atlas or local URI for persistent storage.
MONGODB_URI=
MONGODB_DB_NAME=skaltair
# Optional SMTP notifications for applications and enquiries.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SKALTAIR <noreply@example.org>
SUBMISSION_NOTIFICATION_EMAIL=
